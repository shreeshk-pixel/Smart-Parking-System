# Copy to .env.local for local development. Never commit real values.
# All of these are server-only (no NEXT_PUBLIC_ prefix), so they never reach the browser.

# Postgres connection string (Neon / Vercel Postgres). Remote hosts must use TLS.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# At least 32 random characters, e.g. the output of: openssl rand -base64 48
# Signs login sessions and QR passes and derives the exit-code encryption key.
# Changing it logs everyone out, invalidates all QR passes and gives active bookings new exit codes.
SESSION_SECRET=replace-with-at-least-32-random-characters
